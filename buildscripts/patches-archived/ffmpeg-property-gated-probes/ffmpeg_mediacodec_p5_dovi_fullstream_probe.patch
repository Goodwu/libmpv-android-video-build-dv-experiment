+static void p5_probe_clear_entry(P5ProbeEntry *entry)
+{
+    av_freep(&entry->metadata);
+    av_freep(&entry->raw_rpu);
+    entry->metadata_size = 0;
+    entry->raw_rpu_size = 0;
